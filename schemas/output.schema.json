{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haedar-collab/tradesys-crypto-strategy/schemas/output.schema.json",
  "title": "Tradesys Strategy Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strategy_id", "strategy_version", "evaluated_at", "market_regime", "setups", "risk_decision", "data_quality", "audit"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "strategy_id": { "type": "string" },
    "strategy_version": { "type": "string" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "market_regime": {
      "type": "object",
      "required": ["label", "confidence"],
      "properties": {
        "label": { "type": "string", "enum": ["UPTREND", "SIDEWAYS", "COMPRESSION", "CAPITULATION", "DOWNTREND", "UNKNOWN"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "setups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "direction", "state", "evidence", "invalidation"],
        "properties": {
          "symbol": { "type": "string" },
          "direction": { "const": "LONG" },
          "state": { "type": "string", "enum": ["WATCH", "WAIT_TRIGGER", "READY", "BLOCKED", "EXPIRED"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "invalidation": { "type": "array", "items": { "type": "string" } },
          "entry_zone": { "type": ["object", "null"] },
          "stop_loss": { "type": ["number", "null"] },
          "targets": { "type": "array", "items": { "type": "number" } },
          "reward_risk": { "type": ["number", "null"] },
          "expires_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "risk_decision": {
      "type": "object",
      "required": ["status", "reason_codes"],
      "properties": {
        "status": { "type": "string", "enum": ["ALLOWED", "BLOCKED", "WAIT_DATA"] },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "position_size_quote": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "data_quality": {
      "type": "object",
      "required": ["status", "warnings"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audit": {
      "type": "object",
      "required": ["rule_ids", "parameter_hash"],
      "properties": {
        "rule_ids": { "type": "array", "items": { "type": "string" } },
        "parameter_hash": { "type": "string" }
      }
    }
  }
}
